# ==============================================================================
# BeyondLimits — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (Required for Cloud Database & RLS)
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings > API: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. AI MOTIVATION & RESEARCH (Optional / Recommended)
# ------------------------------------------------------------------------------
# Gemini API Key: Synthesizes neuroscience insights, daily focus themes, and actionable habits
GEMINI_API_KEY=""

# Tavily API Key: Live web search to fetch high-signal discipline & success research
TAVILY_API_KEY=""

# APP_URL: Host application URL (e.g. http://localhost:3000 in dev or production domain)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. LOCAL DATABASE FALLBACK
# ------------------------------------------------------------------------------
# Optional custom path for local SQLite database file.
# Defaults to ./data/discipline-tracker.db locally, or /tmp/discipline-tracker.db on Vercel.
SQLITE_DB_PATH=""

# ------------------------------------------------------------------------------
# 5. DAILY 8:00 PM PHONE NOTIFICATIONS & REMINDERS (Optional)
# ------------------------------------------------------------------------------
# Option A: Free Instant Mobile Push via ntfy.sh (Android & iOS ntfy app)
NTFY_TOPIC="beyondlimits-discipline-8pm"

# Option B: Twilio SMS / WhatsApp API (Direct automated SMS to accountability phones)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
