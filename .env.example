# GEMINI_API_KEY: Required for Gemini AI API calls (Daily Motivation synthesis).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TAVILY_API_KEY: Used for live web search to find the best daily motivation for success and self-discipline.
# Configure this in the AI Studio Secrets panel or Vercel Environment Variables.
TAVILY_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SQLITE_DB_PATH: Optional custom path for the SQLite database file.
# Defaults to ./data/discipline-tracker.db locally, or /tmp/discipline-tracker.db on Vercel serverless.
SQLITE_DB_PATH=""

# PHONE NOTIFICATION CHANNELS (8:00 PM Daily Attendance Reminder)
# Option 1: Free Instant Mobile Push via ntfy.sh (Android / iOS ntfy app topic name)
NTFY_TOPIC="bharath-cd-r-attendance-8pm"

# Option 2: Twilio SMS / WhatsApp API (Optional - sends direct SMS to Bharath CD & Bharath R phones at 8:00 PM)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""


